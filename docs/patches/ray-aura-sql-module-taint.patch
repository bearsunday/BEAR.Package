+++ b/src/AbstractRequest.php
@@ -120,7 +120,9 @@ public function __toString(): string
     /**
      * {@inheritDoc}
      *
-     * @param Query $query
+     * @param Query $query Query parameters that may contain user input
+     *
+     * @psalm-taint-source input $query
      */
